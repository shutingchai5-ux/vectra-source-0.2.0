# VECTRA 2.0.0 - Bun / Vue / TypeScript / Effect
# Independent start/dev use runtime-deploy/<identity>/deployment.json.
# Optional: VECTRA_DEPLOYMENT_FILE=C:/absolute/path/to/your/deployment.json
# The next five settings are legacy-only; deployment.json takes priority.
VECTRA_TS_DATA_DIR=runtime-ts
VECTRA_LOG_DIR=logs
VECTRA_HOST=127.0.0.1
VECTRA_PORT=8000
VECTRA_QUERY_COOLDOWN=30
VECTRA_MPC_TIMEOUT=20
# Seconds: one complete model response and the whole multi-Agent task.
VECTRA_MODEL_TIMEOUT=120
VECTRA_TASK_TIMEOUT=600
# Dashboard settings take priority. Saving does not contact the provider.
LLM_PROVIDER=custom
LLM_BASE_URL=https://api.openai.com/v1
# chat-completions or responses; each Agent can override this in its model settings.
LLM_API_FORMAT=chat-completions
LLM_API_KEY=
LLM_MODEL=
