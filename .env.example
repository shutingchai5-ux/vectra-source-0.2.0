# 默认 demo：无需联网、无需 API Key；真实密码验证和 MPyC 不会被替代。
VECTRA_MODE=demo
# 相对路径始终相对于本项目目录，迁移电脑无需修改；勿填写原电脑的绝对路径。
VECTRA_DATA_DIR=runtime
VECTRA_HOST=127.0.0.1
VECTRA_PORT=8000
# 推荐在网页「模型设置」选择 Demo / API Token 并保存；网页保存的模型配置优先。
# 以下为未保存网页配置时的初始值：切换 VECTRA_MODE=llm，填写支持 function calling 的 Chat Completions 模型。
LLM_PROVIDER=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# 30 秒内同一用户最多启动一个统计；固定三车、固定输出。
VECTRA_QUERY_COOLDOWN=30
VECTRA_MPC_TIMEOUT=20
