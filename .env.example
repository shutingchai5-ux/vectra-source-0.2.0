# VECTRA 1.0.3 - Bun / Vue / TypeScript / Effect
# The new backend deliberately uses a separate data directory.
VECTRA_TS_DATA_DIR=runtime-ts
VECTRA_LOG_DIR=logs
VECTRA_HOST=127.0.0.1
VECTRA_PORT=8000
VECTRA_QUERY_COOLDOWN=30
VECTRA_MPC_TIMEOUT=20
VECTRA_TASK_TIMEOUT=180
# Dashboard settings take priority. Saving does not contact the provider.
LLM_PROVIDER=custom
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
